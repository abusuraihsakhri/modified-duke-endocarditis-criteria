{
  "openapi": "3.1.0",
  "info": {
    "title": "Modified Duke Endocarditis Criteria API",
    "description": "2023 Duke-ISCVID criterion-domain classifier with experimental legacy audit endpoints; not a clinical diagnosis.",
    "version": "1.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy operational counters (JSON)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy experimental worker audit, unrelated to Duke classification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy mock supervisor response; not medical guidance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/classify": {
      "post": {
        "summary": "Classify already-adjudicated 2023 Duke-ISCVID evidence",
        "description": "Requires all 14 boolean criterion domains. Does not interpret raw clinical data.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "definite_pathologic": {
                    "type": "boolean"
                  },
                  "reject_alternative": {
                    "type": "boolean"
                  },
                  "reject_short_therapy": {
                    "type": "boolean"
                  },
                  "reject_negative_surgery": {
                    "type": "boolean"
                  },
                  "major_microbiologic": {
                    "type": "boolean"
                  },
                  "major_imaging": {
                    "type": "boolean"
                  },
                  "major_surgical": {
                    "type": "boolean"
                  },
                  "minor_predisposition": {
                    "type": "boolean"
                  },
                  "minor_fever": {
                    "type": "boolean"
                  },
                  "minor_vascular": {
                    "type": "boolean"
                  },
                  "minor_immunologic": {
                    "type": "boolean"
                  },
                  "minor_microbiologic": {
                    "type": "boolean"
                  },
                  "minor_imaging": {
                    "type": "boolean"
                  },
                  "minor_physical": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "definite_pathologic",
                  "reject_alternative",
                  "reject_short_therapy",
                  "reject_negative_surgery",
                  "major_microbiologic",
                  "major_imaging",
                  "major_surgical",
                  "minor_predisposition",
                  "minor_fever",
                  "minor_vascular",
                  "minor_immunologic",
                  "minor_microbiologic",
                  "minor_imaging",
                  "minor_physical"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Definite, Possible, or Rejected with counts and basis"
          },
          "422": {
            "description": "Invalid or conflicting criterion domains"
          }
        }
      }
    }
  }
}
